                <mxCell id="note1" value="CONCEPTUAL MODEL v0.1&lt;br&gt;&lt;br&gt;Commit ≠ ChangeEvent. Facts do not automatically become Knowledge. Rejected and superseded information remains historically traceable.&lt;br&gt;&lt;br&gt;No physical PostgreSQL schema, junction tables, or Resolution entity are defined here." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1090" width="750" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="note2" value="FLOW&lt;br&gt;&lt;br&gt;Source → Commit → ChangeEvent&lt;br&gt;Source → Evidence → Fact → Knowledge → Document&lt;br&gt;Evidence may originate independently of ChangeEvent." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" parent="1" vertex="1">

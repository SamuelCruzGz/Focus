        <mxCell id="e23" value="N:N relates_to" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=none;startArrow=none;" edge="1" parent="1" source="feature" target="system">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="CONCEPTUAL MODEL v0.1&lt;br&gt;&lt;br&gt;These cardinalities describe the domain model, not the physical database schema. N:N relationships may require junction tables during implementation." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="930" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="CORE PRINCIPLE&lt;br&gt;&lt;br&gt;Source → Evidence → Knowledge → Document&lt;br&gt;Knowledge is the central model that consolidates supported, validated understanding. Evidence does not connect directly to Rule/Feature/System." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="600" y="930" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="VERSIONING&lt;br&gt;&lt;br&gt;Knowledge and Document versions are preserved. supersedes expresses evolution; retention/archiving/storage policy is outside v0.1." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">

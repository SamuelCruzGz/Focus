        <mxCell id="legend1" value="Conceptual model v0.1 | Azul: context | Verde: sources/system | Naranja: events/evidence | Morado: Knowledge core | Rojo: Document | Amarillo: Rule / governance context" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="920" width="1020" height="30" as="geometry" />
